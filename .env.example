# Server-only keys. Copy to .env.local for local development or to your server secret store.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.gpt.ge
OPENAI_MODEL=o3

# Optional dedicated provider for the protected knowledge library.
# These names avoid conflicts with host-level OPENAI_* variables.
KNOWLEDGE_AI_API_KEY=
KNOWLEDGE_AI_BASE_URL=https://api.gpt.ge
KNOWLEDGE_AI_MODEL=gpt-4o-mini

# Optional: use a separate key/base URL for the standalone image page.
# If unset, /api/images falls back to OPENAI_API_KEY and OPENAI_BASE_URL.
IMAGE_OPENAI_API_KEY=
IMAGE_OPENAI_BASE_URL=https://api.gpt.ge

# Optional persistence. Docker Compose sets this automatically.
DATABASE_URL=postgres://chatgreen:chatgreen@postgres:5432/chatgreen

# Optional cron protection. Set a long random string in production.
CRON_SECRET=

# Default crawler queries for /api/cron/refresh.
DEFAULT_NEWS_QUERIES=AI news,world technology news,China economy,US politics

# Local file library. Use /data in the production container.
LIBRARY_DATA_DIR=./data
MAX_UPLOAD_BYTES=104857600

# Library login is configured on first visit to /login and stored as a salted hash in data/auth.
# Set to true only when the site is served over HTTPS.
LIBRARY_SECURE_COOKIE=false
